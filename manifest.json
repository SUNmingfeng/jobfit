{
  "manifest_version": 3,
  "name": "JobFit - 简历JD智能匹配分析器",
  "version": "1.0.0",
  "description": "调用Kimi AI智能分析简历与BOSS直聘职位匹配度",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://www.zhipin.com/*",
    "https://api.moonshot.cn/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.zhipin.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["pdf.worker.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
